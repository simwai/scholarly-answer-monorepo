# Copy to .env. Every value here is a default - nothing is required to run the
# search path, which is keyless.

# --- contact (used for Crossref's and Unpaywall's polite pools) ----------
SEARCH_CONTACT_EMAIL=research@example.invalid

# --- retrieval ------------------------------------------------------------
SEARCH_ENGINES=crossref,arxiv,europepmc
SEARCH_MAX_SOURCES=5
PER_PROVIDER_LIMIT=15
RRF_K=60

# Conditional query expansion. Fires only when raw retrieval was weak.
ENABLE_EXPANSION=true
EXPANSION_MIN_WORKS=3
EXPANSION_MIN_PROVIDERS=2
EXPANSION_MAX_QUERIES=3

# Open-access full text.
ENABLE_FULLTEXT=true
FULLTEXT_CHARS=12000
FULLTEXT_TIMEOUT=30

# Client-side response cache, checked before retrieval.
ENABLE_CACHE=true
CACHE_TTL_SECONDS=900

# OpenAlex: DOI singleton lookups only ($0). search= is metered.
ENABLE_OPENALEX=true
OPENALEX_ENRICH_TOP=10

# Optional keyless provider; off by default because its keyless pool is shared.
ENABLE_SEMANTIC_SCHOLAR=false

# --- pacing ---------------------------------------------------------------
# arXiv asks for one request every three seconds; this is the tightest limit.
ARXIV_INTERVAL=3.0
PROVIDER_MIN_INTERVAL=0.25
REQUEST_TIMEOUT=25

# --- LLM transport -------------------------------------------------------
# "router" uses the Free-Tier Router; "inline" calls providers directly.
SEARCH_LLM_TRANSPORT=router
ROUTER_URL=http://127.0.0.1:8787
ROUTER_ALLOW_FALLBACK=true
ROUTER_DEADLINE=120
SEARCH_LLM_REASONING=high

# Ordered tier list, walked in order when a tier is unusable.
# Verified against Kilo's live catalog - see config.py for the reasoning.
# NOTE: Kilo has no free Stepfun model. Default is free Nemotron 3.5.
ROUTER_PIN=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,kilo-auto/free

# To use StepFun instead (paid, ~$0.004 per synthesis call, reasoning high
# available on both): comment out ROUTER_PIN above and uncomment below.
# ROUTER_PIN=stepfun/step-3.7-flash,stepfun/step-3.5-flash,kilo-auto/free

# Contingency only (SEARCH_LLM_TRANSPORT=inline):
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# KILO_API_KEY=      # optional; the Kilo anonymous tier works without a key
# NVIDIA_API_KEY=     # required only for the NIM tier of the inline chain
